# Copy to .env, chmod 600, then generate fresh secrets. Never commit it.
# These example hostnames cannot be used for a public deployment.
CHAT_HOST=chat.example.invalid
ACME_EMAIL=operator@example.invalid

# Application versions are explicit; record and pin resolved digests before live use.
CHATWOOT_IMAGE=chatwoot/chatwoot:v4.18.0-ce
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.45.6
CHATWOOT_POSTGRES_IMAGE=pgvector/pgvector:pg16
N8N_POSTGRES_IMAGE=postgres:16-alpine
REDIS_IMAGE=redis:7.4-alpine
CADDY_IMAGE=caddy:2.10-alpine
BACKUP_IMAGE=alpine:3.22

# openssl rand -hex 64 for CW_SECRET_KEY_BASE.
CW_SECRET_KEY_BASE=
# openssl rand -hex 32, independently for every field below.
CW_ENCRYPTION_PRIMARY_KEY=
CW_ENCRYPTION_DETERMINISTIC_KEY=
CW_ENCRYPTION_SALT=
CW_DB_PASSWORD=
CW_REDIS_PASSWORD=
N8N_DB_ADMIN_PASSWORD=
N8N_DB_PASSWORD=
N8N_ENCRYPTION_KEY=
SCHEDULER_TIMEZONE=Asia/Kolkata

# One provider-managed platform Meta app, separately authorised business assets.
# Leave empty during local preparation; do not reuse any existing business tokens.
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=
IG_VERIFY_TOKEN=
# Manual WhatsApp onboarding: phone-number ID/WABA/access token belong to each
# Chatwoot inbox. No embedded signup ids or shared WhatsApp token in this file.

# Configure fresh SMTP before invitations/password-reset delivery is tested.
MAILER_SENDER_EMAIL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
