# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/select-tenant
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/select-tenant

# Comma-separated Clerk user IDs allowed to access /super-admin
OS_PLUS_SUPER_ADMIN_CLERK_USER_IDS=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shopify diagnostics: opt-in, Production host only, one server-bound tenant.
# Keep sync disabled. No imported orders or customer messages in this slice.
SHOPIFY_SYNC_ENABLED=false
SHOPIFY_INTAKE_ENABLED=false
SHOPIFY_HYDRATION_ENABLED=false
SHOPIFY_DRAFT_IMPORT_ENABLED=false
# Private source encryption (32 random bytes encoded as base64), NOT client env.
# Provision/rotation/retention approval is required before activation. Leave blank.
SHOPIFY_SOURCE_KEY_ID=
SHOPIFY_SOURCE_ENCRYPTION_KEYS_JSON=
SHOPIFY_PRIVACY_ENABLED=false
SHOPIFY_EXECUTOR_ENABLED=false
SHOPIFY_PILOT_CREDENTIALS_ENABLED=false
# Owner-only, named Test-tenant setup screen. Does not enable imports.
SHOPIFY_CONNECTION_SCREEN_ENABLED=false
SHOPIFY_SOURCE_ENCRYPTION_KEY=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_DEPLOYMENT_ENV=production
SHOPIFY_CONNECTION_TEST_ENABLED=false
SHOPIFY_CONNECTION_TEST_TENANT_ID=
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_APPLICATION_ORIGIN=
# Test pilot application. All operational/public gates remain opt-in.
SHOPIFY_PILOT_OPERATIONS_ENABLED=false
SHOPIFY_TEST_COPY_ENABLED=false
SHOPIFY_RELEASE_ENABLED=false
SHOPIFY_UNINSTALL_ENABLED=false
SHOPIFY_SCHEDULED_WORKER_ENABLED=false
# Private, at least 32 URL-safe random characters. Never NEXT_PUBLIC_.
SHOPIFY_WORKER_SECRET=
# Optional explicit oldest unrevoked app secret during credential rotation.
# Otherwise webhooks use SHOPIFY_CLIENT_SECRET. See deployment checklist.
SHOPIFY_WEBHOOK_SIGNING_SECRET=

# Chat foundation: private versioned 32-byte base64 keys; never NEXT_PUBLIC_.
# Example structure only: {"v1":"<32 random bytes encoded as base64>"}
CHAT_SECRETS_ACTIVE_VERSION=
CHAT_SECRETS_KEYS=
# Real-service tests remain dry-run unless separately authorized.
CHAT_DRY_RUN=true

# Keep foundation hidden until its migrations and phase QA are approved.
CHAT_FOUNDATION_ENABLED=false
# Provider-managed canonical HTTPS origin; never supplied by tenant forms.
CHATWOOT_BASE_URL=
CHATWOOT_PLATFORM_TOKEN=
CHAT_WEBHOOK_ORIGIN=
# External admin API operations require this plus CHAT_DRY_RUN=false.
CHAT_ADMIN_LIVE_ENABLED=false

# CH-3 stage maintenance: disabled until an explicitly authorized scheduler is configured.
CHAT_LEAD_REFRESH_ENABLED=false
# A separate random bearer secret of at least 32 characters. Never expose to the browser.
CHAT_LEAD_REFRESH_SECRET=

# Optional canonical Chatwoot browser origin when its staff UI differs from the API origin.
# HTTPS in production; the isolated local harness supplies its owned HTTP loopback UI.
CHATWOOT_BROWSER_ORIGIN=

# Chat CH-5 stays disabled until separately reviewed; previews use mocks only.
CHAT_AGENT_ENABLED=false
CHAT_AGENT_MODEL_MODE=
CHAT_MOCK_PREVIEW_ENABLED=false
# Human-clicked draft controls still require an authenticated, scoped shared claim.
CHAT_STAFF_DRAFT_SEND_ENABLED=false
CHAT_DRAFT_DELIVERY_ENABLED=false
CHAT_MODEL_LIVE_ENABLED=false
CHAT_MODEL_UNDERSTAND=
CHAT_MODEL_CLASSIFY=
CHAT_MODEL_WRITE=
CHAT_MODEL_PROVIDER=
# Fresh platform key only; keep private and unset during mock-only QA.
OPENROUTER_API_KEY=

# CH-7 notifications are additive and off until local and owner/channel acceptance.
CHAT_NOTIFICATIONS_ENABLED=false
CHAT_NOTIFICATIONS_CRON_ENABLED=false
CHAT_NOTIFICATIONS_CRON_SECRET=
# Canonical trusted OS PLUS origin for authenticated links; never a request Host header.
CHAT_APP_ORIGIN=
# Platform bot credentials stay server-only. Header secret: 32–256 URL-safe random characters.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CHAT_TELEGRAM_LIVE_ENABLED=false
# Disposable loopback mock only; never point this at a real Telegram endpoint.
CHAT_TELEGRAM_MOCK_ENABLED=false
CHAT_TELEGRAM_MOCK_ORIGIN=
CHAT_PLATFORM_ALERTS_ENABLED=false
TELEGRAM_PLATFORM_ALERT_CHAT_ID=

# CH-8 voice is mock-only until separate paid/provider/real-speech acceptance.
CHAT_VOICE_ENABLED=false
CHAT_TRANSCRIPTION_MODE=
CHAT_TRANSCRIPTION_LIVE_ENABLED=false
CHAT_MODEL_TRANSCRIBE=
CHAT_VOICE_MEDIA_MOCK_ENABLED=false
# Explicit owned loopback origins only; never inherit webhook URLs or production media hosts.
CHAT_VOICE_MEDIA_ORIGINS=[]
